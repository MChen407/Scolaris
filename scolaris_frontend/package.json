{
  "name": "scolaris-school-management",
  "description": "Logiciel de gestion scolaire",
  "private": true,
  "version": "1.0.0",
  "author": "Mourchid Assani",
  "main": "electron.js",
  "scripts": {
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "dev": "vite",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "npm run build && electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.4.2",
    "axios": "^1.11.0",
    "chart.js": "^4.5.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "pinia": "^2.1.7",
    "vue": "^3.4.38",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.3",
    "autoprefixer": "^10.4.16",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vue-tsc": "^2.1.4"
  },
  "build": {
    "appId": "com.scolaris.app",
    "productName": "Scolaris",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/logo.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true
    },
    "files": [
      "electron.js",
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../scolaris_backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/**"
        ]
      }
    ]
  }
}
